            ],
            "padding-right": [
              "px"
            ],
            "padding-bottom": [
              "px"
            ],
            "padding-left": [
              "px"
            ],
            "padding-inline": [
              "px"
            ],
            "padding-block": [
              "px"
            ],
            "gap": [
              "px"
            ],
            "row-gap": [
              "px"
            ],
            "column-gap": [
              "px"
            ],
            "border-radius": [
              "px"
            ]
